{
  "expo": {
    "name": "vix",
    "slug": "vix-super-app",
    "owner": "imanuelvic",
    "version": "1.3.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vixsuperapp",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.imanuelvic.vixsuperapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C5C50",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDF6EC",
          "dark": {
            "backgroundColor": "#0C5C50"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "vix mengakses galeri untuk memilih foto anggota keluarga di Family Tree, dokumentasi rapat CORE, dan foto nota di Split Bill.",
          "cameraPermission": "vix memakai kamera untuk memotret nota, lalu isinya dibaca langsung di HP-mu untuk dibagi di Split Bill."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "vix menyimpan gambar Daily Reflection & ayat Alkitab yang kamu buat ke Foto, supaya bisa diunggah ke Instagram.",
          "photosPermission": "vix menyimpan gambar buatanmu ke Foto. Isi galerimu tidak dibaca.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "vix membaca data langkah, kalori aktif, dan tidur dari Apple Health untuk ringkasan kesehatan harian.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "expo-font",
      "expo-sharing",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8629b439-ff28-4bb2-9bfb-a03b644fcfe8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8629b439-ff28-4bb2-9bfb-a03b644fcfe8"
    }
  }
}
