# Firebase Web Config (AMAN untuk client app — ini BUKAN private key Admin SDK)
# Ambil dari: Firebase Console > Project settings > General > Your apps > Web app > firebaseConfig
# Salin file ini menjadi ".env" lalu isi nilainya.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Hanya email ini yang boleh login & lihat data (kunci app-level).
EXPO_PUBLIC_OWNER_EMAIL=
