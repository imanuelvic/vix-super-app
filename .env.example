# Firebase Web Config (AMAN untuk client app — ini BUKAN private key Admin SDK)
# Ambil dari: Firebase Console > Project settings > General > Your apps > Web app > firebaseConfig
# Salin file ini menjadi ".env" lalu isi nilainya.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Hanya email ini yang boleh login & lihat data (kunci app-level).
EXPO_PUBLIC_OWNER_EMAIL=

# App Check 🛡️ — melindungi Firebase AI Logic (Gemini) dari pemakaian orang lain.
# WAJIB terisi sebelum 2 November 2026: setelah tanggal itu App Check ditegakkan
# otomatis untuk AI Logic dan tidak bisa dimatikan, jadi tanpa ini semua fitur AI
# berhenti bekerja. Kosong = app tetap jalan, AI tetap jalan (sampai tanggal itu).
#
# Ambil dari: Firebase Console > Build > App Check > Apps > pilih aplikasi WEB >
# menu ⋮ > Manage debug tokens > Add debug token.
#
# BUKAN nilai publik seperti baris-baris di atas: siapa pun yang memilikinya bisa
# memakai kuota Gemini gratismu. Jangan pernah ikut di-commit, jangan dibagikan.
EXPO_PUBLIC_APP_CHECK_DEBUG_TOKEN=
